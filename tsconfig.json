{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["charts/**/*.ts", "charts/**/*.tsx", "scripts/**/*.ts", "scripts/**/*.tsx", "packages/engine/**/*.ts"]
}
