---
import '@whichart/tokens/whichart.css';
import { GOALS, SPACES, STATES } from '../../preview/wireframe.js';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Homepage wireframe</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  </head>
  <body>
    <div class="banner">Wireframe for review. Rankings are mock data; the real engine arrives in milestone M3.</div>
    <header>
      <a class="wordmark" href={base}>whi<span>chart</span></a>
      <nav>
        <a href="#">Charts</a>
        <a href={`${base}preview/theme/`}>Theme</a>
        <a href="#">Agents</a>
        <button id="theme-toggle" type="button">Dark mode</button>
      </nav>
    </header>

    <main>
      <section class="ask" aria-labelledby="ask-title">
        <h1 id="ask-title">What do you want to show?</h1>
        <div class="drop" id="drop">
          <div id="drop-empty">
            <strong>Drop a CSV or paste data</strong>
            <span>Everything stays in your browser.</span>
            <button type="button" id="use-sample">Try sample: store orders</button>
          </div>
          <div id="drop-loaded" hidden>
            <strong id="file-name"></strong>
            <span id="file-profile"></span>
            <button type="button" id="clear-data">Clear</button>
          </div>
        </div>

        <div class="filters">
          <div class="filter" role="group" aria-label="Goal">
            <span class="filter-label">Goal</span>
            <div class="chips" id="goals">
              {GOALS.map(([id, label]) => <button type="button" class="chip" data-goal={id} aria-pressed="false">{label}</button>)}
            </div>
          </div>
          <div class="filter-row">
            <div class="filter" role="group" aria-label="Space">
              <span class="filter-label">Space</span>
              <div class="segmented" id="spaces">
                {SPACES.map(([id, label]) => <button type="button" data-space={id} aria-pressed={id === 'any' ? 'true' : 'false'}>{label}</button>)}
              </div>
            </div>
            <label class="filter">
              <span class="filter-label">State</span>
              <select id="state">
                {STATES.map(([id, label]) => <option value={id}>{label}</option>)}
              </select>
            </label>
          </div>
        </div>
      </section>

      <p class="summary" id="summary" aria-live="polite"></p>
      <section class="grid" id="grid" aria-label="Charts"></section>

      <section class="avoid" id="avoid-section" hidden>
        <h2>Not a good fit for this data</h2>
        <div class="grid" id="avoid"></div>
      </section>

      <section class="agents">
        <div>
          <strong>For agents</strong>
          <span>Same rules, as tools: recommend, get code, review a chart.</span>
        </div>
        <code id="mcp-cmd">npx @whichart/mcp</code>
        <button type="button" id="copy-mcp">Copy</button>
      </section>
    </main>

    <script>
      import { CHARTS, SAMPLE, thumbnail, stateCaption } from '../../preview/wireframe.js';

      const byId = Object.fromEntries(CHARTS.map((c) => [c.id, c]));
      const params = new URLSearchParams(location.search);
      const state = {
        goal: params.get('goal'),
        space: params.get('space') ?? 'any',
        state: params.get('state') ?? 'normal',
        data: params.get('data') === 'sample',
      };

      const $ = (id) => document.getElementById(id);
      const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);

      function card(chart, extra = {}) {
        const cap = stateCaption(chart, state.state);
        return `<article class="card${extra.avoid ? ' is-avoid' : ''}">
          <div class="thumb">${thumbnail(chart, state.state)}</div>
          <div class="card-body">
            <div class="card-title">
              ${extra.rank ? `<span class="rank">${extra.rank}</span>` : ''}
              <h3>${esc(chart.name)}</h3>
              ${extra.score ? `<span class="score" title="Fit score">${extra.score}</span>` : ''}
            </div>
            ${extra.reason ? `<p class="reason">${esc(extra.reason)}</p>` : ''}
            ${extra.warning ? `<p class="warning">⚠ ${esc(extra.warning)}</p>` : ''}
            ${extra.avoid ? `<p class="why-not">✕ ${esc(extra.avoid)}</p>` : ''}
            ${cap ? `<p class="state-cap"><span class="tag tag-${cap.treatment}">${cap.treatment}</span> ${esc(cap.text)}</p>` : ''}
            ${!extra.reason && !extra.avoid ? `<p class="goals">${chart.goals.map((g) => `<span>${g}</span>`).join('')}</p>` : ''}
          </div>
        </article>`;
      }

      const fits = (c) => (!state.goal || c.goals.includes(state.goal)) && (state.space === 'any' || c.space.includes(state.space));

      function render() {
        let html;
        let shown;
        if (state.data) {
          const ranked = SAMPLE.ranked.filter(([id]) => fits(byId[id]));
          shown = ranked.length;
          html = ranked
            .map(([id, score, reason, warning], i) => card(byId[id], { rank: i + 1, score, reason, warning }))
            .join('');
          const avoid = SAMPLE.avoid.filter(([id]) => fits(byId[id]));
          $('avoid').innerHTML = avoid.map(([id, why]) => card(byId[id], { avoid: why })).join('');
          $('avoid-section').hidden = !avoid.length;
          $('summary').textContent = `${shown} charts ranked for your data${avoid.length ? `, ${avoid.length} not recommended` : ''}.`;
        } else {
          const list = CHARTS.filter(fits);
          shown = list.length;
          html = list.map((c) => card(c)).join('');
          $('avoid-section').hidden = true;
          $('summary').textContent = `${shown} charts${state.goal || state.space !== 'any' ? ' match your filters' : ''}. Drop data to rank them.`;
        }
        $('grid').innerHTML = html || '<p class="empty">No charts match these filters.</p>';

        $('drop-empty').hidden = state.data;
        $('drop-loaded').hidden = !state.data;
        $('file-name').textContent = SAMPLE.label;
        $('file-profile').textContent = SAMPLE.profile;
        document.querySelectorAll('[data-goal]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.goal === state.goal)));
        document.querySelectorAll('[data-space]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.space === state.space)));
        $('state').value = state.state;

        const q = new URLSearchParams();
        if (state.goal) q.set('goal', state.goal);
        if (state.space !== 'any') q.set('space', state.space);
        if (state.state !== 'normal') q.set('state', state.state);
        if (state.data) q.set('data', 'sample');
        history.replaceState(null, '', q.size ? `?${q}` : location.pathname);
      }

      document.querySelectorAll('[data-goal]').forEach((b) =>
        b.addEventListener('click', () => {
          state.goal = state.goal === b.dataset.goal ? null : b.dataset.goal;
          render();
        }),
      );
      document.querySelectorAll('[data-space]').forEach((b) =>
        b.addEventListener('click', () => {
          state.space = b.dataset.space;
          render();
        }),
      );
      $('state').addEventListener('change', (e) => {
        state.state = e.target.value;
        render();
      });
      $('use-sample').addEventListener('click', () => {
        state.data = true;
        render();
      });
      $('clear-data').addEventListener('click', () => {
        state.data = false;
        render();
      });
      $('copy-mcp').addEventListener('click', async (e) => {
        try {
          await navigator.clipboard.writeText($('mcp-cmd').textContent);
          e.target.textContent = 'Copied';
        } catch {
          e.target.textContent = 'Copy failed';
        }
        setTimeout(() => (e.target.textContent = 'Copy'), 1500);
      });
      $('theme-toggle').addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        syncToggle();
      });
      function syncToggle() {
        const root = document.documentElement;
        const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        $('theme-toggle').textContent = dark ? 'Light mode' : 'Dark mode';
      }
      syncToggle();

      render();
    </script>

    <style is:global>
      * { box-sizing: border-box; }
      [hidden] { display: none !important; }
      body {
        margin: 0;
        background: var(--wc-page);
        color: var(--wc-ink-primary);
        font: 15px/1.5 var(--wc-font);
      }
      button, select { font: inherit; color: inherit; }
      a { color: var(--wc-accent); }
      .banner {
        background: var(--wc-surface);
        border-bottom: 1px solid var(--wc-border);
        color: var(--wc-ink-secondary);
        font-size: 13px;
        padding: 8px 16px;
        text-align: center;
      }
      header {
        max-width: 1200px;
        margin: 0 auto;
        padding: 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }
      .wordmark { font-size: 22px; font-weight: 700; letter-spacing: -0.02em; color: var(--wc-ink-primary); text-decoration: none; }
      .wordmark span { color: var(--wc-accent); }
      nav { display: flex; gap: 16px; align-items: center; font-size: 14px; }
      nav a { color: var(--wc-ink-secondary); text-decoration: none; }
      #theme-toggle { background: none; border: 1px solid var(--wc-border); border-radius: 8px; padding: 4px 10px; font-size: 13px; cursor: pointer; }
      main { max-width: 1200px; margin: 0 auto; padding: 0 16px 48px; }
      .ask {
        background: var(--wc-surface);
        border: 1px solid var(--wc-border);
        border-radius: 14px;
        padding: 20px;
        display: grid;
        gap: 16px;
      }
      .ask h1 { margin: 0; font-size: clamp(22px, 4vw, 30px); letter-spacing: -0.02em; }
      .drop {
        border: 1.5px dashed var(--wc-axis);
        border-radius: 10px;
        padding: 16px;
      }
      .drop > div { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; }
      .drop span { color: var(--wc-ink-secondary); font-size: 14px; }
      .drop button, .agents button {
        margin-left: auto;
        background: var(--wc-accent);
        color: var(--wc-on-accent);
        border: 0;
        border-radius: 8px;
        padding: 8px 14px;
        cursor: pointer;
      }
      #clear-data { background: none; color: var(--wc-ink-secondary); border: 1px solid var(--wc-border); }
      .filters { display: grid; gap: 12px; }
      .filter-row { display: flex; flex-wrap: wrap; gap: 12px 24px; }
      .filter { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
      .filter-label { font-size: 13px; color: var(--wc-ink-secondary); min-width: 44px; }
      .chips { display: flex; flex-wrap: wrap; gap: 6px; }
      .chip, .segmented button {
        background: var(--wc-surface);
        border: 1px solid var(--wc-border);
        border-radius: 999px;
        padding: 4px 12px;
        font-size: 13px;
        cursor: pointer;
      }
      .segmented { display: flex; flex-wrap: wrap; gap: 4px; }
      .segmented button { border-radius: 8px; }
      [aria-pressed='true'] { background: var(--wc-accent) !important; border-color: var(--wc-accent) !important; color: var(--wc-on-accent); }
      select { background: var(--wc-surface); border: 1px solid var(--wc-border); border-radius: 8px; padding: 4px 8px; }
      .summary { color: var(--wc-ink-secondary); font-size: 14px; margin: 20px 0 12px; }
      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 12px; }
      .card {
        background: var(--wc-surface);
        border: 1px solid var(--wc-border);
        border-radius: 12px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
      }
      .card.is-avoid { opacity: 0.6; }
      .card.is-avoid .thumb { filter: grayscale(1); }
      .thumb { padding: 10px 10px 0; }
      .thumb svg { display: block; width: 100%; height: auto; }
      .card-body { padding: 8px 14px 14px; display: grid; gap: 4px; }
      .card-title { display: flex; align-items: center; gap: 8px; }
      .card-title h3 { margin: 0; font-size: 15px; flex: 1; }
      .rank {
        background: var(--wc-accent);
        color: var(--wc-on-accent);
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        padding: 0 6px;
      }
      .score { font-size: 12px; color: var(--wc-ink-secondary); font-variant-numeric: tabular-nums; }
      .reason, .warning, .why-not, .state-cap, .goals { margin: 0; font-size: 13px; color: var(--wc-ink-secondary); }
      .warning { color: var(--wc-ink-primary); }
      .why-not { color: var(--wc-ink-primary); }
      .goals { display: flex; flex-wrap: wrap; gap: 4px; }
      .goals span { border: 1px solid var(--wc-border); border-radius: 999px; padding: 0 8px; font-size: 12px; }
      .tag { font-size: 11px; border-radius: 4px; padding: 1px 6px; border: 1px solid var(--wc-border); color: var(--wc-ink-primary); }
      .avoid h2 { font-size: 16px; margin: 32px 0 12px; }
      .agents {
        margin-top: 32px;
        background: var(--wc-surface);
        border: 1px solid var(--wc-border);
        border-radius: 12px;
        padding: 16px;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px 16px;
      }
      .agents div { display: grid; }
      .agents span { color: var(--wc-ink-secondary); font-size: 14px; }
      .agents code { background: var(--wc-page); border: 1px solid var(--wc-border); border-radius: 6px; padding: 4px 10px; }
      .empty { color: var(--wc-ink-secondary); }
      @media (max-width: 520px) {
        nav a:not(:first-child) { display: none; }
        .drop button, .agents button { margin-left: 0; }
        .grid { gap: 8px; }
        .card { flex-direction: row; align-items: center; }
        .thumb { flex: 0 0 40%; padding: 8px; }
        .card-body { padding: 10px 12px 10px 4px; }
        .card-title h3 { font-size: 14px; }
      }
    </style>
  </body>
</html>
