---
import Base from '../../layouts/Base.astro';
import ChartCard from '../../components/ChartCard.astro';
import { GOALS, charts, chartName, planned as plannedList } from '../../lib/content';

const all = charts();
const planned = plannedList();
const written = new Set(all.map((c) => c.id));
const next = [...planned.core, ...planned.later].filter((id: string) => !written.has(id));
const title = 'Chart types A–Z: when to use each, with examples & code | Whichart';
const description = 'Every chart in Whichart: when to use it, how it handles empty and messy data, and ready code for ECharts, Recharts and Plotly.';
---

<Base title={title} description={description}>
  <div class="wrap">
    <h1>Charts</h1>
    <p class="lede muted">Each chart is tested on normal data and up to ten edge cases, in light and dark mode.</p>
    <ul class="chips">{GOALS.map((g) => <li><a class="chip" href={`../categories/${g.id}/`}>{g.label}</a></li>)}</ul>
    <section class="section">
      <div class="grid">{all.map((c) => <ChartCard chart={c} />)}</div>
    </section>
    <section class="section">
      <div class="section-head"><h2>Coming next</h2></div>
      <ul class="chips">{next.map((id: string) => <li><span class="chip">{chartName(id)}</span></li>)}</ul>
    </section>
  </div>
</Base>

<style>
  h1 { font-size: clamp(28px, 4vw, 40px); margin: 24px 0 8px; }
  .lede { font-size: 18px; margin: 0 0 16px; }
</style>
