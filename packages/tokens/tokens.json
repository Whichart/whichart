{
  "name": "whichart-default",
  "version": 1,
  "font": {
    "family": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "size": { "tick": 12, "label": 12, "body": 14, "title": 16, "hero": 32 },
    "tabularNumbers": "tables and axis ticks only"
  },
  "marks": {
    "lineWidth": 2,
    "markerSize": 8,
    "barRadius": 4,
    "gap": 2,
    "gridWidth": 1
  },
  "deltaConvention": "green-up",
  "number": {
    "locale": "en-US",
    "currency": "USD",
    "compact": true
  },
  "sequential": {
    "hue": "blue",
    "steps": [100, 150, 200, 250, 300, 350, 400, 450, 500, 550, 600, 650, 700],
    "blue": ["#cde2fb", "#b7d3f6", "#9ec5f4", "#86b6ef", "#6da7ec", "#5598e7", "#3987e5", "#2a78d6", "#256abf", "#1c5cab", "#184f95", "#104281", "#0d366b"],
    "red": ["#fad6d2", "#f4c2be", "#f1aea8", "#ea9a93", "#e4857e", "#dd716a", "#d75853", "#c74845", "#b13f3c", "#9e3432", "#892b2a", "#762221", "#621b1a"]
  },
  "status": {
    "good": "#0ca30c",
    "warning": "#fab219",
    "serious": "#ec835a",
    "critical": "#d03b3b"
  },
  "modes": {
    "light": {
      "surface": "#fcfcfb",
      "page": "#f9f9f7",
      "ink": { "primary": "#0b0b0b", "secondary": "#52514e", "muted": "#898781" },
      "grid": "#e1e0d9",
      "axis": "#c3c2b7",
      "border": "rgba(11,11,11,0.10)",
      "accent": "#256abf",
      "onAccent": "#ffffff",
      "categorical": ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#6250d6", "#e34948"],
      "divergingMid": "#f0efec",
      "delta": { "good": "#006300", "bad": "#d03b3b", "neutral": "#52514e" }
    },
    "dark": {
      "surface": "#1a1a19",
      "page": "#0d0d0d",
      "ink": { "primary": "#f0efec", "secondary": "#c3c2b7", "muted": "#898781" },
      "grid": "#2c2c2a",
      "axis": "#383835",
      "border": "rgba(255,255,255,0.10)",
      "accent": "#3987e5",
      "onAccent": "#0b0b0b",
      "categorical": ["#3987e5", "#d95926", "#199e70", "#c98500", "#d55181", "#008300", "#9085e9", "#e66767"],
      "divergingMid": "#383835",
      "delta": { "good": "#0ca30c", "bad": "#e66767", "neutral": "#c3c2b7" }
    }
  }
}
