{
  "name": "whichart",
  "private": true,
  "description": "The reference agents and researchers check before making a chart.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter site dev",
    "build": "pnpm --filter site build",
    "preview": "pnpm --filter site preview",
    "validate": "pnpm --filter @whichart/tokens check && node scripts/validate-charts.mjs",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "ajv": "8.18.0",
    "yaml": "2.9.0"
  }
}
