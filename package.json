{
  "name": "whichart",
  "private": true,
  "type": "module",
  "description": "The reference agents and researchers check before making a chart.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter site dev",
    "build": "pnpm --filter site build",
    "preview": "pnpm --filter site preview",
    "validate": "pnpm --filter @whichart/tokens check && node scripts/validate-charts.mjs && node scripts/generate-data.mjs --check && node scripts/build-catalog.mjs --check",
    "test": "pnpm -r --if-present test",
    "data": "node scripts/generate-data.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "render": "node scripts/render/run.mjs",
    "sheets": "node scripts/render/run.mjs --sheet",
    "catalog": "node scripts/build-catalog.mjs",
    "whichart": "node --import tsx packages/engine/src/cli.ts",
    "previews": "node scripts/render/run.mjs --previews=site/public/previews"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.18.0",
    "echarts": "6.1.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.0",
    "plotly.js-dist-min": "4.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "yaml": "2.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
